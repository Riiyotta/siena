  "rules": [
    {
      "id": "NAV_FIRST",
      "severity": "error",
      "text": "Exactly one chrome head (shell.navbar | shell.lead-header | shell.lab-nav) and it is the first node."
    },
    {
      "id": "FOOTER_LAST",
      "severity": "error",
      "text": "Exactly one chrome tail (shell.footer | shell.legal-row) and it is the last node."
    },
    {
      "id": "CHROME_MATCHES_ROUTE",
      "severity": "error",
      "text": "Chrome follows src/routes.js NAV_OVERRIDES: hideChrome routes (/pricing, /book-a-demo) use lead-header + legal-row; hideNav (/ai-lab) uses lab-nav + footer; every other route uses navbar + footer."
    },
    {
      "id": "NAV_OVERRIDE",
      "severity": "error",
      "text": "Navbar state/cta/variant match the override table: /careers CTA 'See open roles' -> /careers#open-roles (variant careers-cta); /about-us and /social-agent forced-scrolled; elsewhere auto + 'Book a demo'."
    },
    {
      "id": "ONE_HERO",
      "severity": "error",
      "text": "Exactly one hero.* node. Named exception: template.conversations-index, template.conversation-detail and template.legal are hero-less (zero heroes)."
    },
    {
      "id": "HERO_AFTER_CHROME",
      "severity": "error",
      "text": "The hero directly follows the chrome head."
    },
    {
      "id": "ONE_PER_PAGE",
      "severity": "error",
      "text": "Sections whose contract says onePerPage appear at most once."
    },
    {
      "id": "MAX_PER_PAGE",
      "severity": "error",
      "text": "Sections with maxPerPage (testimonials.slider 2 on /qa-agent, lab.statement 2, heading.section-title 2, feature.sticky-scroll 2) respect it."
    },
    {
      "id": "NO_ADJACENT_SAME_SECTION",
      "severity": "error",
      "text": "A section type never directly follows itself. Named exceptions: feature.media-row (alternating rows), lab.statement (intro then what-is on /ai-lab), content.transcript-chapter (one per transcript chapter) and content.legal-section (one per legal-document part)."
    },
    {
      "id": "CTA_CLOSES_PAGE",
      "severity": "error",
      "text": "The last conversion closer (cta.main | cta.demo-form | cta.newsletter | cta.lab-newsletter) is the last content node before the chrome tail; only overlay.partner-modal may sit between (/partner-with-siena)."
    },
    {
      "id": "QUIRK_REGISTERED",
      "severity": "error",
      "text": "Replicated live-site quirk sections (quirk.phone-empty-block) appear only on the templates that registered them (add-ons, video)."
    },
    {
      "id": "OUT_OF_SCOPE_ROUTE",
      "severity": "error",
      "text": "Out-of-scope sections (blog, customer stories, integrations, product updates, webinars, previous terms) are never routes and never local hrefs; link to https://www.siena.cx instead."
    },
    {
      "id": "LINK_TARGETS",
      "severity": "error",
      "text": "Local hrefs resolve to a modelled route (optionally with #anchor); external hosts are in templates.json routing.externalHostAllowlist."
    },
    {
      "id": "FORMS_STATIC",
      "severity": "error",
      "text": "Every form is a static look-alike: submitBehavior 'none'. No form posts to Framer, HubSpot, Chili Piper or n8n."
    },
    {
      "id": "EMBED_ALLOWLIST",
      "severity": "error",
      "text": "At most one external embed per page, YouTube only, only in media.video-embed."
    },
    {
      "id": "QUOTE_PROVENANCE",
      "severity": "error",
      "text": "A quote marked verified hash-matches a registered verbatim quote for the same person (assets/verified-quotes.json); a placeholder quote starts with 'Placeholder'."
    },
    {
      "id": "PLACEHOLDER_MARKED",
      "severity": "error",
      "text": "copySource placeholder text starts with Placeholder/Lorem; real-opening-placeholder-tail carries the lorem tail; real text carries no placeholder vocabulary."
    },
    {
      "id": "TESTIMONIAL_SET",
      "severity": "error",
      "text": "Templates that reuse the homepage testimonial set (home, refer, lead-gen, reviews, roi) use verified slides only."
    },
    {
      "id": "TESTIMONIAL_SET_COUNT",
      "severity": "warn",
      "text": "Those templates show all 11 slides on the live site; a different count is a notice, not a failure."
    },
    {
      "id": "ROUTE_VARIANT",
      "severity": "error",
      "text": "Routes bind specific variants (e.g. /insights hero landing vs subpage; /pricing vs /book-a-demo testimonials)."
    },
    {
      "id": "ROUTE_NODE_RULES",
      "severity": "error",
      "text": "Per-route required/forbidden nodes inside a shared template (customer-feedback-analytics has no integrations/testimonial; book-a-demo has no how-pricing/enterprise)."
    },
    {
      "id": "VARIANT_RULES",
      "severity": "error",
      "text": "Variant shape rules: titled sliders carry eyebrow+title; panel-static is one slide; home/compare/addons sticky-scroll block counts and CTA placement; integrations CTA presence; hero.home ticker rows; cta.main button action."
    },
    {
      "id": "REPEAT_COUNTS",
      "severity": "error",
      "text": "Repeatable nodes stay within the template's measured range (insights 3-6 media rows; memory and topics exactly 2)."
    },
    {
      "id": "MOTION_BUDGET",
      "severity": "warn",
      "text": "No real route has more than one scroll-jacking section (sticky-step-switch | hscroll-scrub)."
    },
    {
      "id": "ASSET_ROLE_USAGE",
      "severity": "error",
      "text": "Every assetRole is in assets/asset-roles.json and allowed for the section that uses it."
    },
    {
      "id": "UNIQUE_IDS",
      "severity": "error",
      "text": "Node ids are unique within a page."
    },
    {
      "id": "MODAL_OPENER",
      "severity": "error",
      "text": "overlay.partner-modal is only present with a hero.partner whose CTA opens it."
    },
    {
      "id": "CHAPTER_PARITY",
      "severity": "error",
      "text": "The content.article-chapter-index lists exactly the content.transcript-chapter nodes on the page, same titles in the same order (each index link targets a chapter H2)."
    }
  ]
}
