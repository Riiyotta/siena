{
  "id": "section.hero.referral",
  "registryId": "section.hero.referral",
  "typeId": "hero.referral",
  "version": "1.0.0",
  "category": "hero",
  "purpose": "Refer-a-friend hero: H1 with italic word + 3 numbered steps with gradient connectors; 'Submit a referral' static form in a rainbow ring.",
  "evidenceLevel": "measured",
  "variants": {
    "refer": "863 tall."
  },
  "composes": [
    "component.form-card",
    "primitive.text"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "headline": {
        "type": "string",
        "maxWords": 10,
        "description": "Plain text; wrap at most one phrase in *asterisks* to render it in the display italic cut.",
        "pattern": "^[^*]*(\\*[^*]+\\*[^*]*)?$"
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "string",
          "maxWords": 12
        },
        "minItems": 3,
        "maxItems": 3
      },
      "form": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "maxWords": 3
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxWords": 3
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxWords": 3
                      },
                      "control": {
                        "enum": [
                          "text",
                          "email"
                        ]
                      },
                      "placeholder": {
                        "type": "string",
                        "maxWords": 4
                      }
                    },
                    "required": [
                      "label",
                      "control",
                      "placeholder"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 2
                }
              },
              "required": [
                "label",
                "fields"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 2
          },
          "submitLabel": {
            "type": "string",
            "maxWords": 2
          },
          "submitBehavior": {
            "const": "none"
          }
        },
        "required": [
          "heading",
          "groups",
          "submitLabel",
          "submitBehavior"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "headline",
      "steps",
      "form"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedPatterns": [
      "appear-spring-x",
      "appear-rise"
    ],
    "reducedMotionFallbackRequired": true,
    "allowedFields": [
      "pattern",
      "reducedMotionFallback",
      "delayMs"
    ]
  },
  "responsive": [
    {
      "at": "{foundation.breakpoint.phone-max}",
      "change": "Stacked; fields full width; submit full width."
    }
  ],
  "constraints": {
    "onePerPage": true,
    "mustFollowNav": true
  },
  "measuredFrom": [
    "spec.r1",
    "jsx.refer"
  ],
  "knownQuirks": [
    "'Full name*' is not actually required on live despite the asterisk; group label renders 'YOUR INFORMATIOn' (sic)."
  ]
}
