{
  "id": "section.content.conversation-article",
  "registryId": "section.content.conversation-article",
  "typeId": "content.conversation-article",
  "version": "1.0.0",
  "category": "content",
  "purpose": "Conversation detail: header (kicker link + date, H1, guest line), one YouTube embed (the ONLY external request in the clone), then summary, key takeaways, chapters, full transcript, FAQ in one 800px rich-text column. Long prose is placeholder in the clone.",
  "evidenceLevel": "measured",
  "variants": {
    "standard": "Max-width 800 column, gap 48, no sticky or progress UI."
  },
  "composes": [
    "primitive.text",
    "primitive.link"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string",
        "maxWords": 4
      },
      "headline": {
        "type": "string",
        "maxWords": 16
      },
      "guest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxWords": 4
          },
          "role": {
            "type": "string",
            "maxWords": 8
          },
          "brand": {
            "type": "string",
            "maxWords": 4
          }
        },
        "required": [
          "name",
          "role",
          "brand"
        ],
        "additionalProperties": false
      },
      "video": {
        "type": "object",
        "properties": {
          "assetRole": {
            "const": "embed.youtube"
          },
          "videoId": {
            "type": "string",
            "maxWords": 1,
            "pattern": "^[A-Za-z0-9_-]{11}$"
          }
        },
        "required": [
          "assetRole",
          "videoId"
        ],
        "additionalProperties": false
      },
      "summary": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxWords": 120
            },
            "copySource": {
              "enum": [
                "placeholder"
              ]
            }
          },
          "required": [
            "text",
            "copySource"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 4
      },
      "takeaways": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxWords": 40
            },
            "copySource": {
              "enum": [
                "placeholder"
              ]
            }
          },
          "required": [
            "text",
            "copySource"
          ],
          "additionalProperties": false
        },
        "minItems": 3,
        "maxItems": 8
      },
      "chapters": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "time": {
              "type": "string",
              "maxWords": 1,
              "pattern": "^[0-9]{1,2}:[0-5][0-9]$"
            },
            "title": {
              "type": "string",
              "maxWords": 12
            }
          },
          "required": [
            "time",
            "title"
          ],
          "additionalProperties": false
        },
        "minItems": 3,
        "maxItems": 20
      },
      "transcript": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "chapter": {
              "type": "string",
              "maxWords": 12
            },
            "turns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "speaker": {
                    "type": "string",
                    "maxWords": 3
                  },
                  "seconds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "paragraphs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "maxWords": 150
                        },
                        "copySource": {
                          "enum": [
                            "placeholder"
                          ]
                        }
                      },
                      "required": [
                        "text",
                        "copySource"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 6
                  }
                },
                "required": [
                  "speaker",
                  "seconds",
                  "paragraphs"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 40
            }
          },
          "required": [
            "chapter",
            "turns"
          ],
          "additionalProperties": false
        },
        "minItems": 3,
        "maxItems": 20
      },
      "faq": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "maxWords": 16
            },
            "answer": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "maxWords": 90
                },
                "copySource": {
                  "enum": [
                    "placeholder"
                  ]
                }
              },
              "required": [
                "text",
                "copySource"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "question",
            "answer"
          ],
          "additionalProperties": false
        },
        "minItems": 2,
        "maxItems": 8
      }
    },
    "required": [
      "date",
      "headline",
      "guest",
      "video",
      "summary",
      "takeaways",
      "chapters",
      "transcript",
      "faq"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedPatterns": [
      "none"
    ],
    "reducedMotionFallbackRequired": true,
    "allowedFields": [
      "pattern",
      "reducedMotionFallback",
      "delayMs"
    ]
  },
  "responsive": [
    {
      "at": "{foundation.breakpoint.phone-max}",
      "change": "Padding 100 20 80; H1 48/48; video 350x200; block H2 24/28.8; chapter H2 24/24."
    }
  ],
  "constraints": {
    "onePerPage": true,
    "mustFollowNav": true
  },
  "measuredFrom": [
    "spec.t3",
    "jsx.conv.article",
    "jsx.placeholder.lorem"
  ],
  "copyPolicy": {
    "summary/takeaways/transcript/faq answers": "placeholder in the clone (lorem); generation must not invent what a real named guest said",
    "headline/chapters/questions": "real"
  }
}
