    {
      "id": "demo-form",
      "type": "cta.demo-form",
      "variant": "insights",
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      },
      "content": {
        "heading": "Book a personalized demo now",
        "submitLabel": "Submit",
        "submitBehavior": "none",
        "anchorId": "book-a-demo",
        "fields": [
          {
            "label": "Full name*",
            "control": "text",
            "placeholder": "John Smith"
          },
          {
            "label": "Work email*",
            "control": "email",
            "placeholder": "john.smith@business.com"
          },
          {
            "label": "Company website*",
            "control": "text",
            "placeholder": "www.mywebsite.com"
          },
          {
            "label": "Help desk*",
            "control": "select",
            "options": [
              "Gorgias",
              "Zendesk",
              "Kustomer",
              "Gladly",
              "Intercom",
              "Salesforce",
              "Other"
            ]
          },
          {
            "label": "Monthly average tickets*",
            "control": "select",
            "options": [
              "<5,000",
              "5,000-10,000",
              "10,000-20,000",
              "20,000-30,000",
              "Over 30,000"
            ]
          },
          {
            "label": "Where did you hear about us?*",
            "control": "textarea",
            "placeholder": "Write us something..."
          }
        ]
      }
