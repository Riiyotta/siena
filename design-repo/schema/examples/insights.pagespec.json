        },
        "chat": [
          {
            "speaker": "customer",
            "text": "hey! i need help with an order i placed yesterday—i forgot to apply my discount code."
          },
          {
            "speaker": "siena",
            "text": "no worries! i’ve got your order pulled up. i can apply the code “WELCOME15” and refund the difference—ready to go?"
          },
          {
            "speaker": "customer",
            "text": "yes please! appreciate it."
          },
          {
            "speaker": "siena",
            "text": "done. also noticed you’ve bought from our skincare line twice—our new serum just dropped and it’s a perfect match. want me to add it to your cart with 10% off?"
