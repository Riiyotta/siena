{
  "$description": "Font families, sizes and weights. Every family is a self-hosted woff2 declared in src/index.css; Feature Deck and Tiempos are commercially licensed to Siena (see assets/asset-roles.json fontLicensing) and Font Awesome 6 Sharp/Pro are licensed icon fonts. Sizes are the histogram values actually rendered.",
  "foundation": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "\"Instrument Sans\", sans-serif",
          "$description": "UI and body sans (Google font, OFL).",
          "$extensions": {
            "cite": [
              "tw.fonts",
              "css.fontfaces"
            ],
            "histogram": "fontFamily:Instrument Sans=3533"
          }
        },
